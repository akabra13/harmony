{"nodes": [{"id": "northfield_policy_config_code_boundary", "label": "Config/Code Boundary", "file_type": "rationale", "source_file": "northfield/policy.yaml", "source_location": "northfield/policy.yaml:1-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thresholds and switches live in YAML; the rules that read them live in northfield/rules.py. A policy is a decision, a rule is a program, and pushing the program into YAML would mean inventing a worse language to write it in."}, {"id": "northfield_policy_approval", "label": "Approval Policy", "file_type": "concept", "source_file": "northfield/policy.yaml", "source_location": "northfield/policy.yaml:8-19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "northfield_policy_po_value_limit_key", "label": "PO Value Limit Key (po_create_max_value)", "file_type": "concept", "source_file": "northfield/policy.yaml", "source_location": "northfield/policy.yaml:10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "northfield_policy_escalate_to_manager", "label": "Escalate To Manager", "file_type": "concept", "source_file": "northfield/policy.yaml", "source_location": "northfield/policy.yaml:14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escalation names the reporting line rather than a person, so the policy survives a promotion."}, {"id": "northfield_policy_deadline_end_of_day", "label": "End-of-Day Approval Deadline", "file_type": "concept", "source_file": "northfield/policy.yaml", "source_location": "northfield/policy.yaml:19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An approval unanswered by end of day is re-examined: if the approver is away the next day it routes to their designated backup."}, {"id": "northfield_policy_enforce_part_qualification", "label": "Enforce Part Qualification", "file_type": "conce