# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored. It is loaded automatically by the `harmony` command and by
# the scripts in scripts/ — an already-exported environment variable always wins,
# so `HARMONY_LLM=live harmony eval` overrides whatever is set here.
#
# NOTHING HERE IS REQUIRED. The demo and the tests run in replay mode against the
# recorded exchanges in cassettes/, with no key and no network.


# --- the model -----------------------------------------------------------------

# Only needed to talk to the real API: `harmony eval --live`, or re-recording the
# cassettes with `HARMONY_LLM=record python scripts/author_cassettes.py`.
ANTHROPIC_API_KEY=

# Required only if your key is identity-linked — those keys must name the workspace
# each request acts in, and the API returns a 400 saying so if you omit it. Find the
# id in the Anthropic Console under the workspace's settings. Harmless to set
# otherwise; keys that are not identity-linked ignore it.
ANTHROPIC_WORKSPACE_ID=

# replay  (default) — serve recorded exchanges from cassettes/. No key, no cost.
# live              — call the API. Needs a key.
# record            — call the API and overwrite cassettes/ with what comes back.
HARMONY_LLM=replay

# Which model to call when not replaying. Ids take NO date suffix —
# claude-haiku-4-5, never claude-haiku-4-5-20251001.
#
# The planner is asked for real judgment (weigh reliability against price, decide a
# reroute beats an expedite), so a smaller model may fail the eval cases on
# reasoning rather than on plumbing. Try claude-opus-5 before concluding the
# prompts are wrong.
HARMONY_MODEL=claude-opus-5


# --- everything else -----------------------------------------------------------

# Where the database lives. The demos each use their own temporary database and
# ignore this.
HARMONY_DB=.harmony/harmony.db

# Which installed deployment to run. Optional while only one is registered under
# the `harmony.deployments` entry point — which is the case here.
# HARMONY_DEPLOYMENT=northfield
