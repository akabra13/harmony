# Only needed to re-record cassettes against a live model (`make record`).
# The demo and the tests run in replay mode and need nothing set.
ANTHROPIC_API_KEY=

# replay (default) | record | live
HARMONY_LLM=replay

# Which model to call when not replaying.
HARMONY_MODEL=claude-sonnet-4-5

# Where the database lives. The demos use their own temporary databases.
HARMONY_DB=.harmony/harmony.db

# Which installed deployment to run. Optional when only one is installed.
# HARMONY_DEPLOYMENT=northfield
